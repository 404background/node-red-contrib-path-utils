[
    {
        "id": "basic-example",
        "type": "tab",
        "label": "Basic Path Utils",
        "disabled": false,
        "info": "Basic examples of path-join and path-get nodes"
    },
    {
        "id": "inject-join",
        "type": "inject",
        "z": "basic-example",
        "name": "Join Paths",
        "props": [
            {
                "p": "folder",
                "v": "documents",
                "vt": "str"
            },
            {
                "p": "filename",
                "v": "report.pdf",
                "vt": "str"
            }
        ],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "x": 120,
        "y": 100,
        "wires": [
            [
                "path-join-simple"
            ]
        ]
    },
    {
        "id": "path-join-simple",
        "type": "path-join",
        "z": "basic-example",
        "name": "Join: home + folder + filename",
        "joinParts": [
            {
                "type": "str",
                "value": "/home/user"
            },
            {
                "type": "msg",
                "value": "folder"
            },
            {
                "type": "msg",
                "value": "filename"
            }
        ],
        "outputProperty": "payload",
        "outputPropertyType": "msg",
        "outputAs": "absolute",
        "relativeTo": "",
        "relativeToType": "str",
        "x": 350,
        "y": 100,
        "wires": [
            [
                "debug-join",
                "path-get-parts"
            ]
        ]
    },
    {
        "id": "path-get-parts",
        "type": "path-get",
        "z": "basic-example",
        "name": "Extract Directory",
        "input": "payload",
        "inputType": "msg",
        "getItem": "dirname",
        "outputProperty": "directory",
        "outputPropertyType": "msg",
        "outputAs": "absolute",
        "relativeTo": "",
        "relativeToType": "str",
        "x": 580,
        "y": 100,
